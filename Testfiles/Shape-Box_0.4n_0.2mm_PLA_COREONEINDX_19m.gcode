; toolchange_gcode = {\nlocal speed_tc = min(travel_speed, 350.0) * 60;\nlocal deretract_length = 1.0 * retract_toolchange;\nlocal target_temp = temperature[next_extruder];\nlocal eject_temp = max(160,target_temp - 60);\nlocal filament_area = 3.14 * filament_diameter[next_extruder] * filament_diameter[next_extruder] / 4.0;\nlocal purge_mm = filament_minimal_purge_on_wipe_tower[next_extruder] * 1.0 / filament_area;\nlocal purge_speed_fast = min(10.0*60,max(2.0*60,0.9*60*filament_max_volumetric_speed[next_extruder]/filament_area));\nlocal purge_speed_slow = min(5.0*60,max(2.0*60,0.5*60*filament_max_volumetric_speed[next_extruder]/filament_area));\n}\n\n{if tool_init[next_extruder] == 1}\n  {if is_nil(filament_retract_length_toolchange[next_extruder])}\n    {deretract_length = retract_toolchange + retract_length[next_extruder]}\n  {else}\n    {deretract_length = retract_toolchange + filament_retract_length_toolchange[next_extruder]}\n  {endif}\n{else}\n  {tool_init[next_extruder] = 1}\n{endif}\n\n{if layer_z <= (first_layer_height + 0.0001)}\n  {target_temp = first_layer_temperature[next_extruder]}\n{endif}\n\n\n\n; Change Tool[previous_extruder] -> Tool[next_extruder] (layer [layer_num])\n\n{if is_nil(filament_retract_length_toolchange[current_extruder])}\n  G1 E-[retract_length[current_extruder]] F{retract_speed[current_extruder] * 60}\n{endif}\n\nG1 F{speed_tc}\nM204 S7000\n\n{if not (layer_num < 0 and next_extruder == initial_tool)}\n  G27 W3 Z{travel_max_lift[current_extruder]} P2 R{retract_toolchange} V{retract_speed[current_extruder]} A{travel_slope[current_extruder]}\n  P0 S1 L0 D0\n{endif}\n\nT{next_extruder} S1 L0 D0\n\nM104 S{target_temp}\n\nG12 S90 ; enter cleaner\n\nG0 Z{layer_z + 0.8} ; Lift\n\nM109 C{eject_temp} ; Skip residency\n\n\n\n{if wipe_tower == false}\n;-------Purge Station specific Gcode Start-----\n\n  ;EXCLUDE_E_START\n  G1 E1.6 F{20 * 60} ; Final lock tool\n  ;EXCLUDE_E_END\n\n  G12 S30 ; eject poop\n\n  M106 S{255 / 100 * max_fan_speed[next_extruder]}\n\n  M906 P1 ; Set extruder current\n\n  M109 C{target_temp-5}\n\n  G1 E{deretract_length} F{20 * 60}\n\n  G91 ; use relative coordinates\n  M83 ; extruder relative mode\n  M572 S0.0 ; Disable PressureAdvance\n\n  ;FLUSH_START\n  G1 Y0 E{0.4 * purge_mm} F{purge_speed_slow}\n  G1 Y-1.3 E{0.3 * purge_mm} F{1.3 / (0.3 * purge_mm) * purge_speed_fast}\n  G1 Y0 E{0.05 * purge_mm} F{60}\n  G1 Y1.5 E{0.25 * purge_mm} F{1.5 / (0.3 * purge_mm) * purge_speed_fast}\n  ;FLUSH_END\n\n  M906 P0 ; Revert extruder current\n  M400\n\n  ; RETRACT AFTER TOOLCHANGE START\n  G1 Y0 E-{retract_length[next_extruder]} F{retract_speed[next_extruder] * 60}\n  \n  {e_retracted[next_extruder] = retract_length[next_extruder] + retract_restart_extra_toolchange[next_extruder]}\n  ; RETRACT AFTER TOOLCHANGE END\n\n  G1 F{speed_tc} ;revert travel speed\n\n;-------Purge Station specific Gcode End-----\n\n\n\n\n{else}\n;-------Wipe Tower specific Gcode Start-----\n\n  G1 E2.0 F{retract_speed[current_extruder] * 60}\n\n  G750 Y85 F21000 A\n  G750 Y93 F21000 A\n  G750 Y82 F21000 A\n  G750 Y98.5 F21000 A\n  G750 Y75 F21000 A\n  G750 Y98.5 F21000 A\n\n  M109 S{target_temp}\n  G1 E{retract_toolchange-2.0} F{20 * 60}\n  {e_retracted[next_extruder] = deretract_length - retract_toolchange}\n  G1 F{speed_tc} ;revert travel speed\n;-------Wipe Tower specific Gcode End-----\n{endif}\n  \n\n\nG90 ; use absolute coordinates\nM83 ; extruder relative mode\nG12 S91 ; Exit cleaning station\nG0 Z{layer_z + 1.0} ; Lift\nG4 S0\n
